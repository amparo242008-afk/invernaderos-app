<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuarios — Invernaderos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <p class="brand-mark">Parque ambiental</p>
      <nav>
        <a href="/dashboard">Áreas</a>
        <a href="/llamados">Llamados</a>
        <a href="/empleados">Empleados</a>
        <a href="/usuarios" class="active">Usuarios</a>
        <a href="/reportes">Reportes</a>
      </nav>
      <div class="user-box">
        <p><%= usuario.nombre || usuario.username %></p>
        <a href="/logout">Salir</a>
      </div>
    </aside>

    <main class="content">
      <header class="content-header"><h1>Usuarios del sistema</h1></header>

      <section class="form-card">
        <h2>Crear usuario</h2>
        <form action="/usuarios" method="POST" class="inline-form">
          <input type="text" name="username" placeholder="Usuario" required>
          <input type="password" name="password" placeholder="Contraseña" required>
          <select name="rol" required>
            <option value="administrador">Administrador</option>
            <option value="generico">Genérico / empleado</option>
          </select>
          <select name="empleado_id">
            <option value="">Sin vincular a empleado</option>
            <% empleados.forEach(e => { %>
              <option value="<%= e.id %>"><%= e.nombre %> <%= e.apellido %></option>
            <% }) %>
          </select>
          <button type="submit">Crear</button>
        </form>
      </section>

      <table class="llamados-table">
        <thead>
          <tr><th>Usuario</th><th>Rol</th><th>Empleado vinculado</th><th>Activo</th><th></th></tr>
        </thead>
        <tbody>
          <% usuarios.forEach(u => { %>
            <tr>
              <td><%= u.username %></td>
              <td><%= u.rol %></td>
              <td><%= u.nombre ? `${u.nombre} ${u.apellido}` : '-' %></td>
              <td><%= u.activo ? 'Sí' : 'No' %></td>
              <td style="white-space: nowrap;">
                <button type="button" class="btn-outline" onclick="abrirModalEditar('<%= u.id %>', '<%= u.username %>', '<%= u.rol %>', '<%= u.activo %>', '<%= u.nombre || '' %>', '<%= u.apellido || '' %>', '<%= u.dni || '' %>', '<%= u.telefono || '' %>', '<%= u.email || '' %>', '<%= u.tarea || '' %>', '<%= u.area_id || '' %>')">Editar</button>
                <form action="/usuarios/<%= u.id %>/eliminar" method="POST" style="display:inline;">
                  <button type="submit" class="btn-eliminar" onclick="return confirm('¿Eliminar este usuario?')">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
  <!-- Modal de Edición -->
<div id="modalEditar" class="modal-custom" style="display:none;">
  <div class="modal-content-custom">
    <h3>Editar Usuario</h3>
    <form id="formEditar" method="POST" action="">
      <fieldset style="border:1px solid var(--border); border-radius:4px; padding:12px; margin-bottom:12px;">
        <legend style="font-weight:600; font-size:14px; color:var(--dark-green);">Datos de usuario</legend>
        <div class="form-group">
          <label>Usuario:</label>
          <input type="text" name="username" id="edit_username" required class="form-control">
        </div>
        <div class="form-group">
          <label>Contraseña (dejar vacío para no cambiar):</label>
          <input type="password" name="password" id="edit_password" class="form-control">
        </div>
        <div class="form-group">
          <label>Rol:</label>
          <select name="rol" id="edit_rol" class="form-control">
            <option value="administrador">Administrador</option>
            <option value="generico">Genérico / empleado</option>
          </select>
        </div>
        <div class="form-group">
          <label><input type="checkbox" name="activo" id="edit_activo"> Activo</label>
        </div>
      </fieldset>

      <fieldset style="border:1px solid var(--border); border-radius:4px; padding:12px; margin-bottom:12px;">
        <legend style="font-weight:600; font-size:14px; color:var(--dark-green);">Datos del empleado</legend>
        <div class="form-group">
          <label>Nombre:</label>
          <input type="text" name="nombre" id="edit_nombre" class="form-control">
        </div>
        <div class="form-group">
          <label>Apellido:</label>
          <input type="text" name="apellido" id="edit_apellido" class="form-control">
        </div>
        <div class="form-group">
          <label>DNI:</label>
          <input type="text" name="dni" id="edit_dni" class="form-control">
        </div>
        <div class="form-group">
          <label>Teléfono:</label>
          <input type="text" name="telefono" id="edit_telefono" class="form-control">
        </div>
        <div class="form-group">
          <label>Email:</label>
          <input type="email" name="email" id="edit_email" class="form-control">
        </div>
        <div class="form-group">
          <label>Tarea:</label>
          <input type="text" name="tarea" id="edit_tarea" class="form-control">
        </div>
        <div class="form-group">
          <label>Área:</label>
          <select name="area_id" id="edit_area_id" class="form-control">
            <option value="">Sin área</option>
            <% areas.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.nombre %></option>
            <% }) %>
          </select>
        </div>
      </fieldset>

      <button type="submit" class="btn btn-success">Guardar Cambios</button>
      <button type="button" class="btn btn-secondary" onclick="cerrarModalEditar()">Cancelar</button>
    </form>
  </div>
</div>

<script>
function abrirModalEditar(id, username, rol, activo, nombre, apellido, dni, telefono, email, tarea, area_id) {
    document.getElementById('formEditar').action = '/usuarios/editar/' + id;
    document.getElementById('edit_username').value = username;
    document.getElementById('edit_rol').value = rol;
    document.getElementById('edit_activo').checked = (activo === 'true' || activo === '1');
    document.getElementById('edit_nombre').value = nombre;
    document.getElementById('edit_apellido').value = apellido;
    document.getElementById('edit_dni').value = dni;
    document.getElementById('edit_telefono').value = telefono;
    document.getElementById('edit_email').value = email;
    document.getElementById('edit_tarea').value = tarea;
    document.getElementById('edit_area_id').value = area_id;
    document.getElementById('modalEditar').style.display = 'block';
}

function cerrarModalEditar() {
    document.getElementById('modalEditar').style.display = 'none';
}
</script>
</body>
</html>
