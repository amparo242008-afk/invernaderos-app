<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Invernaderos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <p class="brand-mark">Parque ambiental</p>
      <nav>
        <a href="/dashboard" class="active">Áreas</a>
        <a href="/llamados">Llamados</a>
        <% if (usuario.rol === 'administrador') { %>
        <a href="/empleados">Empleados</a>
        <a href="/usuarios">Usuarios</a>
        <a href="/reportes">Reportes</a>
        <% } %>
      </nav>
      <div class="user-box">
        <p><%= usuario.nombre || usuario.username %></p>
        <a href="/logout">Salir</a>
      </div>
    </aside>

    <main class="content">
      <header class="content-header">
        <h1>Estado de las áreas</h1>
      </header>

      <section class="areas-grid">
        <% areas.forEach(area => { %>
          <article class="area-card">
            <h2><%= area.nombre %></h2>
            <% if (area.tipo) { %>
              <p class="area-metrics"><%= area.tipo %>: <%= area.valor %></p>
            <% } else { %>
              <p class="area-metrics">Sin sensores todavía</p>
            <% } %>
            <p class="area-responsable">
              <%= area.responsable_nombre ? `Responsable: ${area.responsable_nombre} ${area.responsable_apellido}` : 'Sin responsable asignado' %>
            </p>
          </article>
        <% }) %>
        <% if (areas.length === 0) { %>
          <p>No hay áreas cargadas todavía.</p>
        <% } %>
      </section>

      <section class="llamados-section">
        <h2>Últimos llamados</h2>
        <table class="llamados-table">
          <thead>
            <tr><th>Área</th><th>Tipo</th><th>Origen</th><th>Estado</th><th>Fecha</th></tr>
          </thead>
          <tbody>
            <% llamados.forEach(l => { %>
              <tr>
                <td><%= l.area_nombre %></td>
                <td class="tipo-<%= l.tipo %>"><%= l.tipo %></td>
                <td><%= l.origen %></td>
                <td><%= l.atendido ? 'Atendido' : 'Sin atender' %></td>
                <td><%= new Date(l.fecha_hora).toLocaleString('es-AR') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>
  </div>
</body>
</html>
