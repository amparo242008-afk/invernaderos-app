# Copiar como ".env" y completar con tus datos reales. Este archivo NUNCA se sube a GitHub.

# --- Base de datos LOCAL (PostgreSQL instalado en tu PC) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invernaderos
DB_USER=postgres
DB_PASSWORD=123456

# En Render se usa la variable DATABASE_URL (la genera Render automáticamente),
# no hace falta completar los campos de arriba allí.

PORT=3000
SESSION_SECRET=cambiar_esto_por_cualquier_texto_largo

# --- Primer administrador (se crea al correr "node db-setup.js" si no hay usuarios) ---
ADMIN_USER=admin
ADMIN_PASSWORD=CambiarEstaClave

# --- Alertas: Email (opcional, cualquier SMTP sirve, ej. Gmail) ---
# Con Gmail: activá "Verificación en 2 pasos" y creá una "Contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# --- Alertas: WhatsApp (opcional, vía Twilio con su sandbox gratis) ---
# Te dan un SID, un token y un número From (ej: whatsapp:+14155238886).
# Tu número va en TWILIO_WHATSAPP_TO. Ej: whatsapp:+54911XXXXXXXX
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=